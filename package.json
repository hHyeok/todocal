{
  "name": "todocal",
  "version": "0.1.0",
  "description": "Todoist 캘린더 (TodoMate 스타일) + AI 지시",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/index.ts\" \"vite\"",
    "dev:mock": "concurrently -k -n server,web \"TODOCAL_MOCK=1 tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "up": "pnpm install && pnpm build && pnpm start",
    "typecheck": "tsc"
  },
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@dnd-kit/core": "^6.3.1",
    "@doist/todoist-mcp": "^13.4.1",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "@tanstack/react-query": "^5.104.1",
    "date-fns": "^4.4.0",
    "hono": "^4.13.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "private": true,
  "type": "module",
  "bin": {
    "todocal": "bin/todocal.mjs"
  }
}
